# Chave de servidor com a Places API (New) habilitada. Restrinja a chave ao backend.
GOOGLE_MAPS_API_KEY=

# Provedores de IA opcionais (Agente WhatsApp, Intelligence e Copiloto de Gestão).
# Se nenhuma chave for informada, o sistema utiliza o modo simulado/analítico local automaticamente.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RECOVERY_OPENAI_MODEL=

# Evolution API v2. Map each company UUID to its paired WhatsApp instance.
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCES={}

# Timers da Recepcionista IA no WhatsApp (debounce de entrada e delay humanizado de digitação)
WHATSAPP_AI_DEBOUNCE_MS=1500
WHATSAPP_AI_TYPING_DELAY_MS=1200

# Pagamentos online. Gere uma chave exclusiva de pelo menos 32 caracteres no ambiente do backend.
PAYMENT_ENCRYPTION_KEY=
ASAAS_ENVIRONMENT=sandbox
# Chave mestra da conta plataforma no Asaas para criação automática de subcontas (onboarding expresso).
ASAAS_MASTER_API_KEY=
# URL pública do frontend para redirecionamentos pós-OAuth (ex.: http://localhost:3000 ou https://app.seudominio.com).
FRONTEND_URL=http://localhost:3000
# URL pública do backend usada para montar o callback OAuth quando MERCADO_PAGO_REDIRECT_URI não for definida.
API_PUBLIC_URL=http://localhost:3333
# Credenciais do aplicativo OAuth do Mercado Pago (conexão em 1 clique do dono).
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Opcional: sobrescreve a URL de callback OAuth registrada no painel do Mercado Pago.
MERCADO_PAGO_REDIRECT_URI=
# URL HTTPS para a qual o Mercado Pago redireciona o assinante após o checkout.
MERCADO_PAGO_BACK_URL=

# Lista separada por vírgulas de e-mails com permissão de Super-Admin da plataforma SaaS.
SUPER_ADMIN_EMAILS=
