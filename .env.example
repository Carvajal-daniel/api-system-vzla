# Chave de servidor com a Places API (New) habilitada. Restrinja a chave ao backend.
GOOGLE_MAPS_API_KEY=

# Provedores de IA opcionais (Agente WhatsApp, Intelligence e Copiloto de Gestão).
# Se nenhuma chave for informada, o sistema utiliza o modo simulado/analítico local automaticamente.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RECOVERY_OPENAI_MODEL=

# Evolution API v2. Map each company UUID to its paired WhatsApp instance.
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCES={}
